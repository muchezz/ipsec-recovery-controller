[Unit]
Description=Privileged fixed strongSwan statusall helper
Requires=ipsec-recovery-diagnostics-helper.socket
After=ipsec-recovery-diagnostics-helper.socket
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
Sockets=ipsec-recovery-diagnostics-helper.socket
# Install this venv and its entire dependency tree root-owned and not agent-writable.
ExecStart=/opt/ipsec-recovery-helper/current/bin/ipsec-recovery-diagnostics-helper --agent-user ipsec-agent
Restart=on-failure
RestartSec=5
TimeoutStopSec=5
KillMode=control-group
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
UMask=0077
WorkingDirectory=/
