[Unit]
Description=IPsec Recovery Controller (read-only diagnostics)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ipsec-controller
Group=ipsec-controller
Environment=IPSEC_CONTROLLER_CONFIG=/etc/ipsec-recovery-controller/config.yaml
ExecStart=/opt/ipsec-recovery-controller/current/bin/ipsec-recovery-controller
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
LockPersonality=true
UMask=0077
ReadOnlyPaths=/etc/ipsec-recovery-controller
WorkingDirectory=/var/lib/ipsec-recovery-controller
StateDirectory=ipsec-recovery-controller

[Install]
WantedBy=multi-user.target
